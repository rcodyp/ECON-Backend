# -----------------------------------------------------------------------------
# ECON Agent Backend — environment configuration
#
# Copy this file to `.env` and fill in real values. Never commit `.env` to
# source control. In production, prefer a secrets manager or KMS over a
# plaintext .env file, especially for AGENT_SIGNER_PRIVATE_KEY.
# -----------------------------------------------------------------------------

# --- Agent identity (published in ERC-8004 registration metadata) ----------

# The ERC-8004 agentId this backend serves. Must exactly match the agentId
# registered on-chain and the agentId clients send in POST /run.
AGENT_ID=123

AGENT_NAME="Example Data Analysis Agent"
AGENT_DESCRIPTION="Analyzes datasets and returns structured insights."

# Comma-separated list of capability tags, published in /metadata.
AGENT_CAPABILITIES=data-analysis,document-processing

# The controller wallet address that owns/manages this agent's ERC-8004
# registration on-chain. Informational — not used to sign anything here.
AGENT_CONTROLLER=0x0000000000000000000000000000000000000000

# Price this agent charges per completed task, in ECON credits.
AGENT_PRICE_CREDITS=5

# --- Monad Testnet -----------------------------------------------------------

MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# --- CreditVault --------------------------------------------------------------

# Address of the ECON CreditVault contract on Monad Testnet. Payments in
# POST /run must reference this exact vault address.
CREDIT_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Private key of THIS AGENT's own operational wallet, authorized by the
# CreditVault to call settleReservation/releaseReservation on the agent's
# behalf. This is NOT a user's wallet key — never ask users for their keys,
# and never log or return this value. Load it from a secrets
# manager/KMS in production rather than a plaintext .env file.
AGENT_SIGNER_PRIVATE_KEY=

# --- HTTP server ---------------------------------------------------------------

PORT=3000

# The public HTTPS URL this backend is reachable at (used to populate the
# "endpoint" field in ERC-8004 metadata). e.g. https://agent.example.com/run
PUBLIC_ENDPOINT=https://agent.example.com/run

# Comma-separated list of approved ECON frontend origins allowed by CORS.
# e.g. https://app.econ.xyz,https://staging.econ.xyz
ECON_FRONTEND_ORIGIN=https://app.econ.xyz

# Maximum size, in bytes, of the `task` field in POST /run.
MAX_TASK_SIZE=16384

# Hard timeout, in milliseconds, for executing a single task.
REQUEST_TIMEOUT_MS=30000

# --- Logging -------------------------------------------------------------------

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

NODE_ENV=production
